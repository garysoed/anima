{
  "extends": "devbase/ts/tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "paths": {
      "*": ["./*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "playwright.config.ts"]
}
